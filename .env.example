# animeinAPIv2 - environment config
# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# Semua value di bawah sudah mengikuti nilai bawaan yang tersedia publik
# (di-expose lewat JS frontend situs), jadi API tetap jalan tanpa .env.

# Base URL situs + prefix backend JSON (via /api/proxy)
ANIMEIN_BASE_URL=https://animeinweb.com

# "Rahasia" proxy dari frontend situs (bukan lisensi - konsumen publik yang sopan)
ANIMEIN_PROXY_SECRET=animein-secure-proxy-key-123

# Waktu tunggu request (detik)
ANIMEIN_TIMEOUT=15

# Jumlah retry untuk 429/5xx/network error
ANIMEIN_RETRIES=2

# Log level: DEBUG / INFO / WARNING
ANIMEIN_LOG_LEVEL=INFO
